# Copy this file to .env for local Symfony usage, then adjust values.
# Do not commit .env files containing local secrets.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=replace-with-a-local-random-secret
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?queue_name=moderation
MESSENGER_NEW_COMMENTS_TRANSPORT_DSN=doctrine://default?queue_name=new_comments
MESSENGER_FAILED_TRANSPORT_DSN=doctrine://default?queue_name=failed
###< symfony/messenger ###

MODERATION_LLM_BASE_URL=
MODERATION_LLM_MODEL=
MODERATION_LLM_API_KEY=
MODERATION_LLM_TIMEOUT=10

FACEBOOK_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_APP_SECRET=

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=
###< lexik/jwt-authentication-bundle ###
